---
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import StoryChapter from "../components/StoryChapter.astro";
import WeddingPredictions from "../components/WeddingPredictions.astro";
import { storyChapters } from "../data/story";
---

<Base title="Nasza historia | Klaudia & Rafał">
  <main class="historia">
    <SiteNav current="historia" />

    <header class="story-intro">
      <p class="story-intro__label">Nasza historia</p>
      <h1>Zaskakująco<br />dobry plan</h1>
      <p class="story-intro__subtitle">
        Niektóre rzeczy zaplanowaliśmy. Inne po prostu się wydarzyły.
      </p>
      <span class="story-intro__rule" aria-hidden="true"></span>
      <p class="story-intro__note">
        Klaudia &amp; Rafał <span aria-hidden="true">·</span> W siedmiu rozdziałach
      </p>
    </header>

    <div class="story-chapters">
      {storyChapters.map((chapter) => <StoryChapter chapter={chapter} />)}
    </div>

    <WeddingPredictions />
    <p class="back"><a href="/">← Strona główna</a></p>
  </main>
</Base>

<style>
  .historia {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3.5rem 1.25rem;
  }
  .story-intro {
    padding: 2rem 0 4.5rem;
    text-align: center;
  }
  .story-intro__label {
    margin: 0 0 1.5rem;
    color: rgba(0, 0, 0, 0.5);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .story-intro h1 {
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.08;
    text-wrap: balance;
  }
  .story-intro__subtitle {
    margin: 1.5rem auto 0;
    max-width: 22rem;
    color: rgba(0, 0, 0, 0.57);
    font-size: 1rem;
    line-height: 1.8;
    text-wrap: balance;
  }
  .story-intro__rule {
    display: block;
    width: 2.75rem;
    height: 1px;
    margin: 2rem auto;
    background: #c9a96a;
  }
  .story-intro__note {
    margin: 0;
    color: rgba(0, 0, 0, 0.45);
    font-size: 0.75rem;
    line-height: 1.8;
  }
  .story-intro__note span {
    margin: 0 0.5rem;
  }
  .back {
    margin: 3rem 0 0;
    text-align: center;
    font-size: 0.9rem;
  }
  @media (max-width: 768px) {
    .historia {
      padding-top: 2.5rem;
    }
    .story-intro {
      padding: 1rem 0 3.25rem;
    }
    .story-intro__subtitle {
      font-size: 0.9rem;
    }
  }
</style>
